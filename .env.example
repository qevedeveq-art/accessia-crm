# ═══════════════════════════════════════════════════════════
#  ACCESSIA Pro v1.2.0 — Variables d'environnement (template)
#  Copiez ce fichier en .env et adaptez les valeurs
#  ⚠️  NE JAMAIS COMMITTER le .env dans un dépôt Git !
# ═══════════════════════════════════════════════════════════

# ── Backend ─────────────────────────────────────────────────
# Répertoire racine des données (dossier parent de _ACCESSIA_APP)
# macOS (Apple Silicon) : /Users/votre_utilisateur
# Linux : /home/votre_utilisateur/MonDossierTravail
# Windows : C:/Users/votre_utilisateur/MonDossierTravail
SENSIA_BASE_DIR=/Users/votre_utilisateur

DATABASE_URL=sqlite:///./sensia.db

# Clé secrète pour signer les tokens JWT (min 32 caractères aléatoires)
# Générer avec : openssl rand -hex 32
SECRET_KEY=CHANGEZ_MOI_cle_secrete_minimum_32_caracteres_aleatoires

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Frontend ────────────────────────────────────────────────
# Laisser vide en dev local (Next.js proxie auto vers localhost:8000)
# Mettre http://localhost:8001 uniquement si vous utilisez Docker
NEXT_PUBLIC_API_URL=
