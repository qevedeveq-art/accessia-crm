# ═══════════════════════════════════════════════════════════
#  SENSIA MANAGER — Variables d'environnement (template)
#  Copiez ce fichier en .env et adaptez les valeurs
#  ⚠️  NE JAMAIS COMMITTER le .env dans un dépôt Git !
# ═══════════════════════════════════════════════════════════

# ── Backend ─────────────────────────────────────────────────
SENSIA_BASE_DIR=C:/Users/votre_utilisateur/SENSIA DVZ
DATABASE_URL=sqlite:///./sensia.db
# Clé secrète pour signer les tokens JWT (min 32 caractères aléatoires)
SECRET_KEY=CHANGEZ_MOI_cle_secrete_minimum_32_caracteres_aleatoires
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Twenty CRM ──────────────────────────────────────────────
# ⚠️  Changez TOUS les secrets ci-dessous avant mise en production
TWENTY_DB_PASSWORD=twenty_secret_changez_moi
TWENTY_APP_SECRET=app_secret_changez_moi_min_32_chars_ici
TWENTY_ACCESS_TOKEN_SECRET=access_secret_changez_moi_32chars_min
TWENTY_LOGIN_TOKEN_SECRET=login_secret_changez_moi_32chars_min
TWENTY_REFRESH_TOKEN_SECRET=refresh_secret_changez_moi_32chars_min
TWENTY_FILE_TOKEN_SECRET=file_secret_changez_moi_32chars_min

# Token API Twenty (obtenu après création du compte dans Twenty)
# Aller sur http://localhost:3000 > Settings > API > Generate token
TWENTY_API_TOKEN=

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TWENTY_URL=http://localhost:3000
